<Window x:Class="BlindBoxShopManagement.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlindBoxShopManagement"
        mc:Ignorable="d"
        Title="Login" Height="420" Width="360" Background="WhiteSmoke" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Account: " HorizontalAlignment="Left" Height="25" Margin="72,115,0,0" VerticalAlignment="Top" Width="67" RenderTransformOrigin="1.204,-0.492"/>
        <Label Content="Password:" HorizontalAlignment="Left" Height="25" Margin="72,184,0,0" VerticalAlignment="Top" Width="67"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="72,145,0,0" TextWrapping="Wrap" x:Name="accountTxt" VerticalAlignment="Top" Width="208" />
        <Button Click="Button_Login" Content= "Login" HorizontalAlignment="Center" Height="23" Margin="0,261,0,0" VerticalAlignment="Top" Width="132"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Height="25" Margin="72,209,0,0" VerticalAlignment="Top" Width="208"/>

    </Grid>
</Window>
