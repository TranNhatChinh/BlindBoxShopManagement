<Window x:Class="BlindBoxShopManagement.OrderingWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlindBoxShopManagement"
        mc:Ignorable="d"
        Title="OrderingWindow2" Height="450" Width="800"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <DataGrid Name="dgvDisplay"
                  Grid.Column="0"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  Margin="50,154,50,128"
                  SelectionMode="Extended" 
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="OK" Click="OkClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,60" Width="100" Height="30"/>
    </Grid>
</Window>