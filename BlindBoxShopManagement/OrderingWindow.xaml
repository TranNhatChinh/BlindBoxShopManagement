<Window x:Class="BlindBoxShopManagement.OrderingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Order" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <!-- Thông tin khách hàng -->
        <GroupBox Header="Customer Information" Height="120" Margin="0,0,0,400">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Customer Name:" Width="100"/>
                    <TextBox x:Name="txtCustomerName" Width="300"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Phone Number:" Width="100"/>
                    <TextBox x:Name="txtPhoneNumber" Width="300"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Danh sách sản phẩm và số lượng -->
        <GroupBox Header="Order Details" Margin="0,130,0,100">
            <Grid>
                <DataGrid Name="dgvOrderItems" 
          AutoGenerateColumns="False" 
          CanUserAddRows="False" 
          Margin="20,40,20,80" 
          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPrice}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Bottom">
                    <Label Content="Grand Total: "/>
                    <Label x:Name="lblGrandTotal" Content="0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Add Product" Click="AddProductClick" HorizontalAlignment="Right" Margin="0,0,237,-96" Width="100" VerticalAlignment="Bottom"/>
            </Grid>
        </GroupBox>

        <!-- Nút lưu và hủy -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom">
            <Button Content="Save Order" Click="SaveOrderClick" Width="100" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="CancelClick" Width="100"/>
        </StackPanel>
    </Grid>
</Window>