<Window x:Class="BlindBoxShopManagement.OrderHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlindBoxShopManagement"
        mc:Ignorable="d"
        Title="OrderHistoryWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <DataGrid Name="dgvDisplay"
          Grid.Column="0"
          Grid.Row="0"
          AutoGenerateColumns="False"
          Margin="55,144,45,38"
                  CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Order Id" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Create At" Binding="{Binding CreatedAt}" Width="*"/>
                <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice}" Width="*"/>
                <DataGridTemplateColumn  Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Details"
                    Click="DetailsButton_Click"
                    Padding="5,2"
                    Margin="5,0"
                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <TextBox x:Name="txtCustomerName" HorizontalAlignment="Center" Height="36" Margin="0,42,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="347"/>
        <Label Content="FInd by customer name:" HorizontalAlignment="Left" Height="36" Margin="80,42,0,0" VerticalAlignment="Top" Width="143"/>
        <Label Content="Find by Date:" HorizontalAlignment="Left" Height="36" Margin="80,103,0,0" VerticalAlignment="Top" Width="182"/>
        <Button Content="Search" Click="SearchByCustomerNameClick" HorizontalAlignment="Left" Height="36" Margin="620,42,0,0" VerticalAlignment="Top" Width="83"/>
        <Button Content="Search" Click="SearchByDateClick" HorizontalAlignment="Left" Height="36" Margin="457,103,0,0" VerticalAlignment="Top" Width="83"/>
        <DatePicker x:Name="DpPicker" HorizontalAlignment="Left" Height="36" Margin="226,103,0,0" VerticalAlignment="Top" Width="214"/>



    </Grid>
</Window>
