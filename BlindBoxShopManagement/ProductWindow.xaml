<Window x:Class="BlindBoxShopManagement.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlindBoxShopManagement"
        mc:Ignorable="d"
        Title="ProductWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel>
            <StackPanel>
                <DataGrid Name="dgvDisplay" Grid.Column="0" Grid.Row="0" AutoGenerateColumns="False" SelectedCellsChanged="dgvDisplay_SelectedCellsChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}"/>
                        <DataGridTextColumn Header="CreatedAt" Binding="{Binding CreatedAt}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Search by product name" Width="150"/>
                <TextBox Name="txtSearchByProductName" Width="200" Margin="0 0 10 0"/>
                <Button x:Name="btnSearchByProductName" Content="Search By Product Name" Click="btnSearchByProductName_Click"/>
            </StackPanel>
            <StackPanel>
                <UniformGrid Columns="2" Margin="5">
                    <Label Content="Id" Width="100"/>
                    <TextBox Name="txtId" Width="200" Margin="0 0 10 0" IsReadOnly="True"/>

                    <Label Content="Name" Width="100"/>
                    <TextBox Name="txtName" Width="200" Margin="0 0 10 0"/>

                    <Label Content="Description" Width="100"/>
                    <TextBox Name="txtDescription" Width="200" Margin="0 0 10 0"/>

                    <Label Content="Price" Width="100"/>
                    <TextBox Name="txtPrice" Width="200" Margin="0 0 10 0"/>

                    <Label Content="Stock" Width="100"/>
                    <TextBox Name="txtStock" Width="200" Margin="0 0 10 0"/>

                    <Label Content="CreatedAt" Width="100"/>
                    <DatePicker Name="dpCreatedAt" Width="200" Margin="0 0 10 0"/>

                </UniformGrid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnDelete" Content="Delete" Click="btnDelete_Click" Margin="0 0 20 0" Width="50"/>
                <Button x:Name="btnAdd" Content="Add" Click="btnAdd_Click" Margin="0 0 20 0" Width="50"/>
                <Button x:Name="btnUpdate" Content="Update" Click="btnUpdate_Click" Margin="0 0 20 0" Width="50"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
